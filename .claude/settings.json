{
  "permissions": {
    "deny": [
      "Bash(tccutil reset*)",
      "Bash(*TCC.db*)",
      "Bash(*csrutil disable*)",
      "Bash(*spctl --master-disable*)",
      "Bash(defaults write com.apple.symbolichotkeys*)",
      "Edit(./tests.json)",
      "Write(./tests.json)"
    ],
    "ask": [
      "Bash(scripts/release.sh)",
      "Bash(./scripts/release.sh)",
      "Bash(git tag *)",
      "Bash(gh release create*)",
      "Bash(asc *)",
      "Bash(xcrun notarytool*)",
      "Bash(git stash*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.claude/hooks/claude-gate\" ] || \"$HOME/.claude/hooks/claude-gate\" baseline"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.claude/hooks/claude-gate\" ] || \"$HOME/.claude/hooks/claude-gate\" stop -- './init.sh check --unsigned'",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
