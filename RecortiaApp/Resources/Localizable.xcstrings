{
  "sourceLanguage": "en",
  "strings": {
    "Destination saved, but the previous destination's token could not be removed from Keychain.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Destination saved, but the previous destination's token could not be removed from Keychain."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Destino salvo, mas o token do destino anterior não pôde ser removido do Keychain."
          }
        }
      }
    },
    "Quit and discard your edits?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit and discard your edits?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sair e descartar suas edições?"
          }
        }
      }
    },
    "An open image has changes that were not copied, saved, dragged, or pinned. Quitting discards them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An open image has changes that were not copied, saved, dragged, or pinned. Quitting discards them."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma imagem aberta tem alterações que não foram copiadas, salvas, arrastadas nem fixadas. Sair descarta essas alterações."
          }
        }
      }
    },
    "%lld open images have changes that were not copied, saved, dragged, or pinned. Quitting discards them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld open images have changes that were not copied, saved, dragged, or pinned. Quitting discards them."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld imagens abertas têm alterações que não foram copiadas, salvas, arrastadas nem fixadas. Sair descarta essas alterações."
          }
        }
      }
    },
    "Quit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sair"
          }
        }
      }
    },
    "Another image is still being opened. Try again when it finishes.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Another image is still being opened. Try again when it finishes." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Outra imagem ainda está sendo aberta. Tente novamente quando terminar." } }
      }
    },
    "Opening the image was canceled.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Opening the image was canceled." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "A abertura da imagem foi cancelada." } }
      }
    },
    "GitHub": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub"
          }
        }
      }
    },
    "Repository owner": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repository owner"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Proprietário do repositório"
          }
        }
      }
    },
    "Private repository": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private repository"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositório privado"
          }
        }
      }
    },
    "Fine-grained GitHub token": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fine-grained GitHub token"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Token de acesso limitado do GitHub"
          }
        }
      }
    },
    "Save destination and token": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save destination and token"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvar destino e token"
          }
        }
      }
    },
    "GitHub destination": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub destination"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Destino no GitHub"
          }
        }
      }
    },
    "Automatic upload": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic upload"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envio automático"
          }
        }
      }
    },
    "Upload automatically after capture": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload automatically after capture"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar automaticamente após a captura"
          }
        }
      }
    },
    "Remove destination and token": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove destination and token"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover destino e token"
          }
        }
      }
    },
    "Automatic upload is off. Save a destination and token first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic upload is off. Save a destination and token first."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O envio automático está desativado. Salve primeiro um destino e um token."
          }
        }
      }
    },
    "Enable automatic upload to GitHub?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable automatic upload to GitHub?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativar o envio automático para o GitHub?"
          }
        }
      }
    },
    "Enable automatic upload": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable automatic upload"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativar envio automático"
          }
        }
      }
    },
    "Destination saved. Enable automatic upload separately.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Destination saved. Enable automatic upload separately."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Destino salvo. Ative o envio automático separadamente."
          }
        }
      }
    },
    "Use a dedicated private repository and a fine-grained token restricted to it, with Contents: read and write. The token stays in Keychain. Each upload creates a commit in screenshots/.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a dedicated private repository and a fine-grained token restricted to it, with Contents: read and write. The token stays in Keychain. Each upload creates a commit in screenshots/."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um repositório privado dedicado e um token limitado a ele, com permissão Contents: leitura e escrita. O token fica nas Chaves. Cada envio cria um commit em screenshots/."
          }
        }
      }
    },
    "When enabled, each still capture is uploaded before later edits or redaction. Uploads require a private repository and are limited to 8 MB. Git history retains earlier images; turning this off or closing Recortia does not delete remote copies.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, each still capture is uploaded before later edits or redaction. Uploads require a private repository and are limited to 8 MB. Git history retains earlier images; turning this off or closing Recortia does not delete remote copies."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, cada captura estática é enviada antes de edições ou tarjas posteriores. Os envios exigem um repositório privado e têm limite de 8 MB. O histórico do Git mantém imagens anteriores; desativar o envio ou fechar o Recortia não exclui cópias remotas."
          }
        }
      }
    },
    "Every new still capture will be sent to %@/%@ before you can edit or redact it. Remote copies cannot be recalled.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every new still capture will be sent to %@/%@ before you can edit or redact it. Remote copies cannot be recalled."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada nova captura estática será enviada para %1$@/%2$@ antes que você possa editar ou aplicar tarjas. Não é possível recuperar as cópias remotas."
          }
        }
      }
    },
    "%@/%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@/%@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@/%2$@"
          }
        }
      }
    },
    "View on GitHub": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View on GitHub"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver no GitHub"
          }
        }
      }
    },
    "Enter a valid GitHub owner and repository name.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid GitHub owner and repository name."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe um proprietário e um nome de repositório válidos no GitHub."
          }
        }
      }
    },
    "Save a GitHub token in Settings before uploading.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save a GitHub token in Settings before uploading."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve um token do GitHub nos Ajustes antes de enviar."
          }
        }
      }
    },
    "The GitHub token could not be accessed in Keychain.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The GitHub token could not be accessed in Keychain."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar o token do GitHub nas Chaves."
          }
        }
      }
    },
    "Upload refused: the GitHub repository is public.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload refused: the GitHub repository is public."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envio recusado: o repositório do GitHub é público."
          }
        }
      }
    },
    "GitHub uploads are limited to 8 MB. Reduce the export scale.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub uploads are limited to 8 MB. Reduce the export scale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os envios ao GitHub têm limite de 8 MB. Reduza a escala de exportação."
          }
        }
      }
    },
    "GitHub denied access. Check the private repository and token permissions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub denied access. Check the private repository and token permissions."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GitHub negou o acesso. Confira o repositório privado e as permissões do token."
          }
        }
      }
    },
    "GitHub rate limit reached. Try again later.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub rate limit reached. Try again later."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite de requisições do GitHub atingido. Tente novamente mais tarde."
          }
        }
      }
    },
    "GitHub could not create this file. No existing file was replaced.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub could not create this file. No existing file was replaced."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GitHub não conseguiu criar este arquivo. Nenhum arquivo existente foi substituído."
          }
        }
      }
    },
    "Upload stopped because the image or upload consent changed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload stopped because the image or upload consent changed."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O envio parou porque a imagem ou o consentimento de envio mudou."
          }
        }
      }
    },
    "Upload canceled before sending the image.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload canceled before sending the image."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envio cancelado antes de enviar a imagem."
          }
        }
      }
    },
    "GitHub could not be reached. No image upload was started.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub could not be reached. No image upload was started."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar o GitHub. Nenhum envio de imagem foi iniciado."
          }
        }
      }
    },
    "The upload may have reached GitHub. Check the repository before trying again; remote copies cannot be recalled.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The upload may have reached GitHub. Check the repository before trying again; remote copies cannot be recalled."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O envio pode ter chegado ao GitHub. Confira o repositório antes de tentar novamente; não é possível recuperar as cópias remotas."
          }
        }
      }
    },
    "GitHub returned an unexpected response. Upload stopped.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub returned an unexpected response. Upload stopped."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GitHub retornou uma resposta inesperada. O envio parou."
          }
        }
      }
    },
    "Automatic export was skipped because another export is still running.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic export was skipped because another export is still running."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A exportação automática foi ignorada porque outra exportação ainda está em andamento."
          }
        }
      }
    },
    "Capture, editing and recognition stay on this Mac. Optional GitHub upload runs only when you enable it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture, editing and recognition stay on this Mac. Optional GitHub upload runs only when you enable it."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A captura, a edição e o reconhecimento são locais neste Mac. O envio opcional ao GitHub ocorre somente quando você o ativa."
          }
        }
      }
    },
    "Recortia keeps no local screenshot history. Optional GitHub upload sends still captures only after separate setup and consent.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recortia keeps no local screenshot history. Optional GitHub upload sends still captures only after separate setup and consent."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Recortia não mantém um histórico local de capturas. O envio opcional ao GitHub envia capturas estáticas somente após configuração e consentimento separados."
          }
        }
      }
    },
    "Show Capture Menu": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show Capture Menu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar menu de captura"
          }
        }
      }
    },
    "Drag to select an area, or press Space to choose a window. Press Return to capture the whole display or Escape to cancel.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to select an area, or press Space to choose a window. Press Return to capture the whole display or Escape to cancel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para selecionar uma área ou pressione Espaço para escolher uma janela. Pressione Return para capturar a tela inteira ou Esc para cancelar."
          }
        }
      }
    },
    "Recortia's default shortcuts are the macOS Screenshot ones: ⇧⌘3 for the display, ⇧⌘4 for a region (press Space for a window), and ⇧⌘5 for every capture mode. If another screenshot app already uses them, clear them here; you can change them later in Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recortia's default shortcuts are the macOS Screenshot ones: ⇧⌘3 for the display, ⇧⌘4 for a region (press Space for a window), and ⇧⌘5 for every capture mode. If another screenshot app already uses them, clear them here; you can change them later in Settings."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os atalhos padrão do Recortia são os do app Captura de Tela do macOS: ⇧⌘3 para a tela inteira, ⇧⌘4 para uma região (pressione Espaço para uma janela) e ⇧⌘5 para todos os modos de captura. Se outro app de captura já usa esses atalhos, limpe-os aqui; você pode alterá-los depois em Ajustes."
          }
        }
      }
    },
    "Restore Defaults": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore Defaults"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar padrões"
          }
        }
      }
    },
    "The defaults match the macOS Screenshot app: ⇧⌘3 captures the display, ⇧⌘4 a region (press Space for a window), and ⇧⌘5 shows every capture mode. Recortia warns about conflicts with macOS and menu shortcuts it can detect, but it cannot know every shortcut other apps use.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The defaults match the macOS Screenshot app: ⇧⌘3 captures the display, ⇧⌘4 a region (press Space for a window), and ⇧⌘5 shows every capture mode. Recortia warns about conflicts with macOS and menu shortcuts it can detect, but it cannot know every shortcut other apps use."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os padrões são os do app Captura de Tela do macOS: ⇧⌘3 captura a tela inteira, ⇧⌘4 uma região (pressione Espaço para uma janela) e ⇧⌘5 mostra todos os modos de captura. O Recortia avisa sobre conflitos com atalhos do macOS e de menus que consegue detectar, mas não tem como conhecer todos os atalhos usados por outros apps."
          }
        }
      }
    },
    "macOS is using this shortcut.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS is using this shortcut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS está usando este atalho."
          }
        }
      }
    },
    "macOS is still using some of these shortcuts. Turn them off in System Settings › Keyboard › Keyboard Shortcuts › Screenshots, and Recortia starts using them. Recortia never changes them itself.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS is still using some of these shortcuts. Turn them off in System Settings › Keyboard › Keyboard Shortcuts › Screenshots, and Recortia starts using them. Recortia never changes them itself."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS ainda está usando alguns destes atalhos. Desative-os em Ajustes do Sistema › Teclado › Atalhos de Teclado › Capturas de Tela e o Recortia passa a usá-los. O Recortia nunca os altera por conta própria."
          }
        }
      }
    },
    "Open Keyboard Settings…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Keyboard Settings…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir Ajustes de Teclado…"
          }
        }
      }
    },
    "Automatic copy, save, and scrolling were turned off because their saved settings could not be verified. Turn them on again if you want them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic copy, save, and scrolling were turned off because their saved settings could not be verified. Turn them on again if you want them."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia, o salvamento e a rolagem automáticos foram desativados porque as configurações salvas não puderam ser verificadas. Ative-os de novo se quiser."
          }
        }
      }
    },
    "Drag the image into another app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the image into another app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste a imagem para outro app."
          }
        }
      }
    },
    "Drag to Export": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to Export"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para exportar"
          }
        }
      }
    },
    "Exported image, draggable": {
      "localizations": {
        "en": {
